    {
      "id": "TC_A11Y_005",
      "title": "Validation errors accessible on submission",
      "wcagCriterion": "3.3.1 Error Identification, 3.3.3 Error Suggestion",
      "componentElement": "Inline validation error messages",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-514",
      "preconditions": "Admin submits form with empty mandatory fields",
      "steps": [
        "1. Submit form with empty fields",
        "2. Verify inline errors appear",
        "3. Verify errors have role='alert' or aria-live",
        "4. Verify errors linked via aria-describedby",
        "5. Verify aria-invalid='true' on invalid fields",
        "6. Verify errors suggest correction",
        "7. Verify error text has 4.5:1 contrast",
        "8. Verify focus moves to first error"
      ],
      "expectedResults": [
        "Inline errors appear",
        "Errors announced",
        "Errors linked to fields",
        "aria-invalid set",
        "Errors suggest fix",
        "Error text has contrast",
        "Focus on first error",
        "WCAG 3.3.1, 3.3.3, 1.4.3 compliant"
      ],
      "postconditions": "Validation errors verified",
      "testResult": "PASS"
    },
