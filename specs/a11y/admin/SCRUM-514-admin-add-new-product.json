{
  "jiraStory": "SCRUM-514",
  "title": "Admin Add a New Product - Accessibility Test Plan (WCAG 2.1 AA)",
  "overview": "Comprehensive accessibility test plan for Admin Add a New Product form covering WCAG 2.1 AA compliance across 11 sections: Basic Information, Product Description, Unique Feature & Buying Guide, Technical Specifications, Product Images, Product Video, Pricing & Inventory, Support & Delivery, Geographical Availability, Links, and Tags/Keywords. Covers form labels, validation errors, GenAI assist, file uploads, and responsive design.",
  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "All mandatory fields have proper labels",
      "wcagCriterion": "1.3.1 Info and Relationships, 4.1.2 Name Role Value",
      "componentElement": "All mandatory form fields across sections",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-514",
      "preconditions": "Admin is on Add New Product form",
      "steps": [
        "1. Verify Product Name has visible label",
        "2. Verify Product Type dropdown has label",
        "3. Verify Vendor field has label",
        "4. Verify Disability Type has label",
        "5. Verify Short Description has label",
        "6. Verify Detailed Description has label",
        "7. Verify Primary Image upload has label",
        "8. Verify Base Price has label",
        "9. Verify SKU has label",
        "10. Verify Support Helpline has label",
        "11. Verify all labels programmatically associated"
      ],
      "expectedResults": [
        "All mandatory fields have visible labels",
        "Labels programmatically associated",
        "Screen reader announces each label",
        "WCAG 1.3.1, 4.1.2 compliant"
      ],
      "postconditions": "All labels verified",
      "testResult": "FAIL"
    },
    {
      "id": "TC_A11Y_002",
