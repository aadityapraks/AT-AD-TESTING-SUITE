      "componentElement": "Required field indicators",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-514",
      "preconditions": "Admin is on Add New Product form",
      "steps": [
        "1. Verify mandatory fields have visual indicator (asterisk)",
        "2. Verify aria-required='true' or required attribute",
        "3. Verify screen reader announces 'required'",
        "4. Verify not relying on color alone"
