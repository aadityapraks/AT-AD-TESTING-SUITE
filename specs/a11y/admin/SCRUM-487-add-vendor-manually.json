{
  "jiraStory": "SCRUM-487",
  "title": "Admin Add Vendor Manually - Accessibility Test Plan (WCAG 2.1 AA)",
  "overview": "Comprehensive accessibility test plan for Admin Add Vendor Manually feature covering WCAG 2.1 AA compliance for Add Vendor modal form with multiple input fields, mandatory field validation, duplicate detection warning, unsaved changes warning, and form submission.",
  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "Add Vendor button keyboard accessible",
      "wcagCriterion": "2.1.1 Keyboard, 4.1.2 Name Role Value",
      "componentElement": "Add Vendor button",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-487",
      "preconditions": "Admin is on Vendor Management page",
      "steps": [
        "1. Tab to Add Vendor button",
        "2. Verify focus indicator visible with 3:1 contrast",
        "3. Verify button has accessible name ('Add Vendor')",
        "4. Press Enter to activate",
        "5. Verify Add Vendor modal opens"
      ],
      "expectedResults": [
        "Button reachable via Tab",
        "Focus indicator visible",
        "Button has accessible name",
        "Enter/Space activates button",
        "Modal opens on activation",
        "WCAG 2.1.1, 4.1.2, 2.4.7 compliant"
      ],
      "postconditions": "Add Vendor modal is open",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_002",
      "title": "Add Vendor modal has role='dialog' and aria-modal",
      "wcagCriterion": "4.1.2 Name Role Value",
      "componentElement": "Add Vendor modal dialog",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-487",
      "preconditions": "Add Vendor modal is open",
      "steps": [
        "1. Verify modal has role='dialog'",
        "2. Verify aria-modal='true'",
        "3. Verify modal has accessible name (aria-labelledby or aria-label)",
        "4. Verify focus moves to modal on open",
        "5. Use screen reader to verify dialog announced"
      ],
      "expectedResults": [
        "Modal has role='dialog'",
        "aria-modal='true' present",
        "Modal has accessible name",
        "Focus moves to modal",
        "Screen reader announces dialog",
        "WCAG 4.1.2 compliant"
      ],
      "postconditions": "Modal ARIA attributes verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_003",
      "title": "Modal focus trap works correctly",
      "wcagCriterion": "2.1.2 No Keyboard Trap",
      "componentElement": "Modal focus management",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-487",
      "preconditions": "Add Vendor modal is open",
      "steps": [
        "1. Tab through all elements in modal",
        "2. Verify focus cycles within modal only",
        "3. Verify background content not reachable via Tab",
        "4. Verify Escape closes modal",
        "5. Verify focus returns to Add Vendor button on close"
      ],
      "expectedResults": [
        "Focus trapped within modal",
        "Background not reachable",
        "Escape closes modal",
        "Focus returns to trigger",
        "WCAG 2.1.2 compliant"
      ],
      "postconditions": "Focus trap verified",
      "testResult": "PASS"
