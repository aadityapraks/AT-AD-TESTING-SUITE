{
  "jiraStory": "SCRUM-80",
  "title": "SCRUM-80: PwD - View Product Pricing and Vendor Information - Accessibility Test Plan",
  "overview": "Accessibility test plan for pricing and vendor info: price with currency symbol and semantic markup, Contact Vendor popup as role=dialog with aria-modal=true, focus trap inside dialog, Esc closes and returns focus, aria-labelledby on dialog, semantic content with tel:/mailto: links, vendor logo ALT text, contrast ≥4.5:1, touch targets ≥44px, mobile responsive, no time limits.",
  "testCases": [
    { "id": "TC_A11Y_001", "title": "Price displayed with currency symbol and accessible to screen readers", "wcagCriterion": "4.1.2", "priority": "Critical", "steps": ["Navigate to product details", "Locate price text", "Verify ₹ symbol and numeric value", "Verify screen reader announces price"], "expectedResults": ["Price accessible with currency", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_002", "title": "Contact Vendor button keyboard accessible", "wcagCriterion": "2.1.1, 4.1.2", "priority": "Critical", "steps": ["Tab to Contact Vendor button", "Verify focus indicator", "Verify accessible name", "Press Enter to activate"], "expectedResults": ["Button keyboard accessible", "WCAG 2.1.1, 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_003", "title": "Vendor popup has role=dialog and aria-modal=true", "wcagCriterion": "4.1.2", "priority": "Critical", "steps": ["Click Contact Vendor", "Verify popup has role=dialog", "Verify aria-modal=true"], "expectedResults": ["Dialog semantics correct", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_004", "title": "Vendor popup has aria-labelledby referencing title", "wcagCriterion": "4.1.2", "priority": "High", "steps": ["Open vendor popup", "Verify aria-labelledby or aria-label present", "Verify title announced on open"], "expectedResults": ["Dialog has accessible name", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_005", "title": "Focus moves inside dialog on open", "wcagCriterion": "2.4.3", "priority": "Critical", "steps": ["Click Contact Vendor", "Verify focus moves to first focusable element inside dialog"], "expectedResults": ["Focus inside dialog on open", "WCAG 2.4.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_006", "title": "Focus trapped inside dialog while open", "wcagCriterion": "2.1.2", "priority": "Critical", "steps": ["Open vendor popup", "Tab through all elements", "Verify Tab cycles within dialog only", "Shift+Tab also stays within dialog"], "expectedResults": ["Focus trapped in dialog", "WCAG 2.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_007", "title": "Escape closes dialog and returns focus to trigger", "wcagCriterion": "2.1.1", "priority": "Critical", "steps": ["Open vendor popup", "Press Escape", "Verify dialog closes", "Verify focus returns to Contact Vendor button"], "expectedResults": ["Esc closes dialog", "Focus returns to trigger", "WCAG 2.1.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_008", "title": "Dialog content uses semantic HTML", "wcagCriterion": "1.3.1", "priority": "High", "steps": ["Open vendor popup", "Verify headings, paragraphs, lists used", "Verify content in meaningful order"], "expectedResults": ["Semantic HTML in dialog", "WCAG 1.3.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_009", "title": "Phone number uses tel: link", "wcagCriterion": "1.3.1", "priority": "High", "steps": ["Open vendor popup", "Verify phone number is a[href='tel:...'] link", "Verify link keyboard accessible"], "expectedResults": ["Phone is tel: link", "WCAG 1.3.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_010", "title": "Email uses mailto: link", "wcagCriterion": "1.3.1", "priority": "High", "steps": ["Open vendor popup", "Verify email is a[href='mailto:...'] link", "Verify link keyboard accessible"], "expectedResults": ["Email is mailto: link", "WCAG 1.3.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_011", "title": "Vendor logo has appropriate ALT text", "wcagCriterion": "1.1.1", "priority": "High", "steps": ["Open vendor popup", "Locate vendor logo image", "Verify alt text present or aria-hidden for decorative"], "expectedResults": ["Logo has ALT or aria-hidden", "WCAG 1.1.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_012", "title": "Contact icons have accessible labels", "wcagCriterion": "1.1.1, 4.1.2", "priority": "High", "steps": ["Open vendor popup", "Inspect phone/email/web icons", "Verify icons have visually hidden text or aria-label"], "expectedResults": ["Icons have accessible labels", "WCAG 1.1.1, 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_013", "title": "Dialog text contrast meets 4.5:1", "wcagCriterion": "1.4.3", "priority": "High", "steps": ["Open vendor popup", "Inspect text contrast", "Verify ≥4.5:1 for normal text"], "expectedResults": ["Text contrast ≥4.5:1", "WCAG 1.4.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_014", "title": "Dialog buttons have visible focus indicators", "wcagCriterion": "2.4.7", "priority": "High", "steps": ["Open vendor popup", "Tab through buttons/links", "Verify focus indicators visible with ≥3:1 contrast"], "expectedResults": ["Focus indicators visible", "WCAG 2.4.7 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_015", "title": "Dialog touch targets ≥44x44px on mobile", "wcagCriterion": "2.5.5", "priority": "High", "steps": ["Set viewport to 375x667", "Open vendor popup", "Verify buttons/links ≥44x44px"], "expectedResults": ["Touch targets adequate", "WCAG 2.5.5 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_016", "title": "Dialog adapts to mobile viewport without clipping", "wcagCriterion": "1.4.10", "priority": "High", "steps": ["Set viewport to 375x667", "Open vendor popup", "Verify content visible without clipping", "Verify close button visible"], "expectedResults": ["Dialog responsive on mobile", "WCAG 1.4.10 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_017", "title": "Opening dialog does not cause unexpected navigation", "wcagCriterion": "3.2.1, 3.2.2", "priority": "High", "steps": ["Click Contact Vendor", "Verify no page reload or navigation", "Verify dialog opens as overlay"], "expectedResults": ["No unexpected navigation", "WCAG 3.2.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_018", "title": "No time-limited content in dialog", "wcagCriterion": "2.2.1", "priority": "Medium", "steps": ["Open vendor popup", "Verify no auto-close timer", "Verify content remains until user closes"], "expectedResults": ["No time limits", "WCAG 2.2.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_019", "title": "Info note text meets contrast requirements", "wcagCriterion": "1.4.3", "priority": "Medium", "steps": ["Locate info note like 'Check with vendor for insurance'", "Verify text contrast ≥4.5:1"], "expectedResults": ["Info note meets contrast", "WCAG 1.4.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_020", "title": "Complete vendor popup workflow keyboard only", "wcagCriterion": "2.1.1", "priority": "Critical", "steps": ["Tab to Contact Vendor", "Press Enter to open", "Tab through dialog content", "Press Escape to close", "Verify focus returns to trigger"], "expectedResults": ["Full workflow keyboard-only", "WCAG 2.1.1 compliant"], "testResult": "NOT RUN" }
