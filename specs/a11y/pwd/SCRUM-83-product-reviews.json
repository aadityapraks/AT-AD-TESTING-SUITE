{"jiraStory":"SCRUM-83","title":"SCRUM-83: PwD - Product Reviews and Ratings - Accessibility Test Plan","overview":"Accessibility test plan for reviews and ratings: star rating role=img with aria-label, no-reviews placeholder announced, review list keyboard-operable, textarea with visible label and aria-describedby, character counter with aria-live, submit button accessible, error messages via aria-live=assertive, success confirmation via role=status, contrast ≥4.5:1, 200% zoom, mobile touch targets ≥44px.","testCases":[{"id":"TC_A11Y_001","title":"Star rating uses semantic markup with aria-label","wcagCriterion":"1.1.1, 4.1.2","priority":"Critical","steps":["Navigate to product page","Inspect star rating element","Verify role=img or img with alt","Verify aria-label like 'Rated X out of 5 stars'"],"expectedResults":["Rating has semantic markup","WCAG 1.1.1, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_002","title":"No reviews placeholder text displayed and announced","wcagCriterion":"4.1.2","priority":"High","steps":["Navigate to product with no reviews","Click Reviews tab","Verify 'No reviews yet' text visible","Verify announced to screen readers"],"expectedResults":["Placeholder visible and announced","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_003","title":"Review list items keyboard navigable","wcagCriterion":"2.1.1","priority":"High","steps":["Click Reviews tab","Tab through review items","Verify interactive elements focusable"],"expectedResults":["Reviews keyboard navigable","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_004","title":"Rating color indicators meet ≥4.5:1 contrast","wcagCriterion":"1.4.3","priority":"High","steps":["Inspect star rating colors","Verify contrast ≥4.5:1 against background"],"expectedResults":["Rating contrast ≥4.5:1","WCAG 1.4.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_005","title":"Review textarea has visible label programmatically associated","wcagCriterion":"3.3.2, 4.1.2","priority":"Critical","steps":["Click Reviews tab","Locate review textarea","Verify visible label like 'Write your review'","Verify label associated via for/id or aria-label"],"expectedResults":["Textarea has programmatic label","WCAG 3.3.2, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_006","title":"Textarea placeholder is not the only label","wcagCriterion":"3.3.2","priority":"High","steps":["Inspect textarea","Verify visible label exists separate from placeholder"],"expectedResults":["Label not placeholder-only","WCAG 3.3.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_007","title":"Character limit instructions via aria-describedby","wcagCriterion":"3.3.2","priority":"High","steps":["Inspect textarea","Verify aria-describedby references instruction text","Verify instruction mentions character limit"],"expectedResults":["Instructions programmatically linked","WCAG 3.3.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_008","title":"Character counter updates via aria-live","wcagCriterion":"4.1.3","priority":"High","steps":["Type in textarea","Verify character counter updates","Verify aria-live=polite on counter"],"expectedResults":["Counter updates announced","WCAG 4.1.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_009","title":"Textarea keyboard accessible","wcagCriterion":"2.1.1","priority":"Critical","steps":["Tab to textarea","Verify focus indicator visible","Type text","Shift+Tab to move out"],"expectedResults":["Textarea keyboard accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_010","title":"Submit button keyboard accessible","wcagCriterion":"2.1.1, 4.1.2","priority":"Critical","steps":["Tab to Submit button","Verify focus indicator","Verify accessible name","Press Enter to submit"],"expectedResults":["Submit button keyboard accessible","WCAG 2.1.1, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_011","title":"Validation errors visible and announced via aria-live","wcagCriterion":"3.3.1, 4.1.3","priority":"Critical","steps":["Submit empty review","Verify error message visible","Verify aria-live=assertive or role=alert","Verify error linked via aria-describedby"],"expectedResults":["Errors visible and announced","WCAG 3.3.1, 4.1.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_012","title":"Error message contrast ≥4.5:1","wcagCriterion":"1.4.3","priority":"High","steps":["Trigger validation error","Verify error text contrast ≥4.5:1"],"expectedResults":["Error contrast ≥4.5:1","WCAG 1.4.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_013","title":"Success confirmation announced via role=status","wcagCriterion":"4.1.3","priority":"High","steps":["Submit valid review","Verify success message visible","Verify role=status or aria-live=polite"],"expectedResults":["Success announced","WCAG 4.1.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_014","title":"Focus returns after submit","wcagCriterion":"2.4.3","priority":"High","steps":["Submit review","Verify focus returns to logical element (textarea or Write Review button)"],"expectedResults":["Focus managed after submit","WCAG 2.4.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_015","title":"Star rating input keyboard operable","wcagCriterion":"2.1.1","priority":"High","steps":["Tab to star rating input","Use arrow keys or Enter to select rating","Verify selection announced"],"expectedResults":["Rating input keyboard accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_016","title":"Review text contrast meets 4.5:1","wcagCriterion":"1.4.3","priority":"High","steps":["Inspect review text, reviewer name, date","Verify contrast ≥4.5:1"],"expectedResults":["Review text contrast ≥4.5:1","WCAG 1.4.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_017","title":"Reviews section usable at 200% zoom","wcagCriterion":"1.4.4","priority":"High","steps":["Set zoom to 200%","Verify reviews visible","Verify textarea usable","Verify no content clipping"],"expectedResults":["Reviews usable at 200%","WCAG 1.4.4 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_018","title":"Reviews accessible on mobile viewport","wcagCriterion":"1.4.10, 2.5.5","priority":"High","steps":["Set viewport to 375x667","Verify reviews visible","Verify textarea touch target ≥44px","Verify submit button tappable"],"expectedResults":["Reviews accessible on mobile","WCAG 1.4.10, 2.5.5 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_019","title":"No disruption while typing in textarea","wcagCriterion":"3.2.2","priority":"High","steps":["Focus textarea","Type text","Verify no auto-refresh or focus shifts","Verify no popups"],"expectedResults":["No disruption while typing","WCAG 3.2.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_020","title":"No keyboard traps in reviews section","wcagCriterion":"2.1.2","priority":"Critical","steps":["Tab through all review elements","Verify focus moves past reviews","No traps"],"expectedResults":["No keyboard traps","WCAG 2.1.2 compliant"],"testResult":"NOT RUN"}]}
