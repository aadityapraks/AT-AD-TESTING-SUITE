  "overview": "Accessibility test plan for catalog search: search bar ARIA label and placeholder, screen-reader focus, suggestions dropdown with arrow key navigation, Enter triggers search with live region announcement, no-results message with role=alert, color contrast, focus indicators, assistive tech compatibility.",
  "testCases": [
    { "id": "TC_A11Y_001", "title": "Search bar has ARIA label and placeholder text", "wcagCriterion": "4.1.2, 3.3.2", "priority": "Critical", "steps": ["Navigate to catalog", "Inspect search bar", "Verify accessible name 'Search devices'", "Verify placeholder text present"], "expectedResults": ["Search bar has programmatic label", "Placeholder describes purpose", "WCAG 4.1.2, 3.3.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_002", "title": "Search bar is keyboard focusable", "wcagCriterion": "2.1.1", "priority": "Critical", "steps": ["Tab to search bar", "Verify focus indicator visible", "Verify screen reader announces label"], "expectedResults": ["Search bar reachable via Tab", "Focus indicator ≥3:1 contrast", "WCAG 2.1.1, 2.4.7 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_003", "title": "Screen reader announces typed characters in search bar", "wcagCriterion": "4.1.2", "priority": "High", "steps": ["Focus search bar", "Type characters", "Verify input role is textbox", "Verify value updates announced"], "expectedResults": ["Input has role=textbox", "Characters announced", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_004", "title": "Search suggestions dropdown accessible with arrow keys", "wcagCriterion": "2.1.1", "priority": "High", "steps": ["Type 3+ characters in search bar", "Verify suggestions dropdown appears", "Use ArrowDown/ArrowUp to navigate suggestions", "Verify focused suggestion announced"], "expectedResults": ["Suggestions navigable via arrow keys", "Active suggestion announced", "WCAG 2.1.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_005", "title": "Pressing Enter triggers search and results count announced", "wcagCriterion": "4.1.3", "priority": "Critical", "steps": ["Type search term", "Press Enter", "Verify results update", "Verify device count announced via ARIA live region"], "expectedResults": ["Enter triggers search", "Results count announced", "WCAG 4.1.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_006", "title": "No results message has role=alert", "wcagCriterion": "4.1.3, 3.3.1", "priority": "Critical", "steps": ["Search for non-existent term", "Verify no-results message displayed", "Verify message has role=alert or aria-live", "Verify message text is descriptive"], "expectedResults": ["No-results message visible and announced", "role=alert or aria-live present", "WCAG 4.1.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_007", "title": "Search results grid keyboard navigable", "wcagCriterion": "2.1.1", "priority": "High", "steps": ["Perform a search", "Tab through result cards", "Verify each card/link focusable", "Verify no keyboard traps"], "expectedResults": ["Results navigable via Tab", "No keyboard traps", "WCAG 2.1.1, 2.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_008", "title": "Search bar focus indicator meets contrast", "wcagCriterion": "2.4.7", "priority": "High", "steps": ["Tab to search bar", "Verify focus outline visible", "Verify contrast ≥3:1"], "expectedResults": ["Focus indicator visible", "Contrast ≥3:1", "WCAG 2.4.7 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_009", "title": "Search bar color contrast meets 4.5:1", "wcagCriterion": "1.4.3", "priority": "High", "steps": ["Inspect search bar text and background colors", "Verify contrast ratio ≥4.5:1"], "expectedResults": ["Text contrast ≥4.5:1", "WCAG 1.4.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_010", "title": "Search works with voice input software", "wcagCriterion": "2.5.3", "priority": "Medium", "steps": ["Verify search bar has visible label matching accessible name", "Verify voice command 'Click Search devices' would target the field"], "expectedResults": ["Visible label matches accessible name", "WCAG 2.5.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_011", "title": "Search bar usable at 200% zoom", "wcagCriterion": "1.4.4", "priority": "High", "steps": ["Set zoom to 200%", "Verify search bar visible and usable", "Verify no horizontal scrolling"], "expectedResults": ["Search bar usable at 200%", "WCAG 1.4.4 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_012", "title": "Search bar accessible on mobile viewport", "wcagCriterion": "1.4.10", "priority": "High", "steps": ["Set viewport to 375x667", "Verify search bar visible", "Verify touch target adequate"], "expectedResults": ["Search bar accessible on mobile", "WCAG 1.4.10 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_013", "title": "Complete search workflow keyboard only", "wcagCriterion": "2.1.1", "priority": "Critical", "steps": ["Tab to search bar", "Type keyword", "Press Enter", "Tab through results", "Complete without mouse"], "expectedResults": ["Entire search workflow keyboard-only", "WCAG 2.1.1 compliant"], "testResult": "NOT RUN" },
