{"jiraStory":"SCRUM-106","title":"SCRUM-106: PwD - Homepage and Dashboard - Accessibility Test Plan","overview":"Accessibility test plan for homepage and dashboard: navigation links keyboard accessible with ARIA labels, carousel with pause/prev/next controls, summary widgets non-interactive with alt text, featured devices and success stories sections, sign-in popup accessible, landmarks (header/main/footer), responsive, WCAG 2.1 AA, focus indicators, contrast ≥4.5:1, 200% zoom.","testCases":[{"id":"TC_A11Y_001","title":"Navigation links keyboard accessible with ARIA labels","wcagCriterion":"2.1.1, 4.1.2","priority":"Critical","steps":["Navigate to home page","Tab through nav links (Home, Catalog, Stories, Help)","Verify each focusable with visible indicator","Verify accessible names"],"expectedResults":["Nav links keyboard accessible","WCAG 2.1.1, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_002","title":"Skip to content link available","wcagCriterion":"2.4.1","priority":"High","steps":["Press Tab on page load","Verify skip link appears","Activate skip link"],"expectedResults":["Skip link functional","WCAG 2.4.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_003","title":"Page has header, main, footer landmarks","wcagCriterion":"1.3.1","priority":"High","steps":["Inspect page landmarks","Verify banner, main, contentinfo present"],"expectedResults":["Landmarks present","WCAG 1.3.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_004","title":"Carousel has accessible controls","wcagCriterion":"2.1.1, 4.1.2","priority":"High","steps":["Locate hero carousel","Verify prev/next buttons keyboard accessible","Verify pause control if auto-rotating"],"expectedResults":["Carousel controls accessible","WCAG 2.1.1, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_005","title":"Carousel auto-rotation can be paused","wcagCriterion":"2.2.2","priority":"High","steps":["If carousel auto-rotates","Verify pause button available","Verify keyboard accessible"],"