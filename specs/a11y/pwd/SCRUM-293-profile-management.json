{"jiraStory":"SCRUM-293","title":"SCRUM-293: PwD - Profile Management - Accessibility Test Plan","overview":"Accessibility test plan for profile management: tabs (Profile/Wishlist/Inquiries/Settings) with role=tab/tablist, aria-selected, keyboard nav, profile header accessible (name/email/tags), Edit Profile button keyboard operable, form fields labeled, Save/Cancel keyboard, Export Data button, Wishlist cards with image ALT/name/price/View Details, Inquiries list accessible, Settings Delete Account confirmation dialog, contrast ≥4.5:1, 200% zoom, mobile responsive, no keyboard traps.","testCases":[{"id":"TC_A11Y_001","title":"Profile tabs use role=tab/tablist","wcagCriterion":"4.1.2","priority":"Critical","steps":["Navigate to profile page","Inspect tab elements","Verify role=tab on Profile, Wishlist, Inquiries, Settings","Verify role=tablist on container"],"expectedResults":["Tab roles present","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_002","title":"Active tab has aria-selected=true","wcagCriterion":"4.1.2","priority":"Critical","steps":["Verify Profile tab active by default","Verify aria-selected=true","Click another tab and verify state updates"],"expectedResults":["Active tab indicated","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_003","title":"Tabs keyboard navigable","wcagCriterion":"2.1.1","priority":"Critical","steps":["Focus first tab","Use arrow keys to navigate","Press Enter to activate"],"expectedResults":["Tabs keyboard navigable","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_004","title":"Profile header displays name and email accessibly","wcagCriterion":"4.1.2","priority":"High","steps":["Verify user name in h1","Verify email visible","Verify screen reader announces both"],"expectedResults":["Header accessible","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_005","title":"Export Data button keyboard accessible","wcagCriterion":"2.1.1, 4.1.2","priority":"High","steps":["Tab to Export Data button","Verify focusable","Verify accessible name","Press Enter"],"expectedResults":["Export button accessible","WCAG 2.1.1, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_006","title":"Personal Information heading accessible","wcagCriterion":"1.3.1","priority":"High","steps":["Verify Personal Information heading present","Verify heading level appropriate"],"expectedResults":["Heading accessible","WCAG 1.3.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_007","title":"Edit Profile button keyboard accessible","wcagCriterion":"2.1.1, 4.1.2","priority":"Critical","steps":["Tab to Edit Profile button","Verify focusable","Press Enter to activate","Verify fields become editable"],"expectedResults":["Edit button accessible","WCAG 2.1.1, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_008","title":"Edit form fields have labels","wcagCriterion":"3.3.2, 4.1.2","priority":"Critical","steps":["Click Edit Profile","Verify each field has visible label","Verify labels programmatically associated"],"expectedResults":["Fields labeled","WCAG 3.3.2, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_009","title":"Save/Cancel buttons keyboard accessible","wcagCriterion":"2.1.1","priority":"Critical","steps":["Click Edit Profile","Tab to Save Changes button","Tab to Cancel button","Verify both focusable and activatable"],"expectedResults":["Save/Cancel accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_010","title":"Wishlist tab cards accessible","wcagCriterion":"1.1.1, 2.1.1","priority":"High","steps":["Click Wishlist tab","Verify device cards have image ALT","Verify View Details CTA keyboard accessible"],"expectedResults":["Wishlist cards accessible","WCAG 1.1.1, 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_011","title":"Wishlist empty state announced","wcagCriterion":"4.1.2","priority":"High","steps":["If wishlist empty","Verify empty state message visible","Verify announced to screen readers"],"expectedResults":["Empty state announced","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_012","title":"Inquiries tab list accessible","wcagCriterion":"1.3.1, 2.1.1","priority":"High","steps":["Click Inquiries tab","Verify inquiry items have device name, image, price","Verify keyboard navigable"],"expectedResults":["Inquiries accessible","WCAG 1.3.1, 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_013","title":"Delete Account button keyboard accessible with confirmation","wcagCriterion":"2.1.1, 3.3.4","priority":"Critical","steps":["Click Settings tab","Tab to Delete Account button","Press Enter","Verify confirmation dialog appears","Verify dialog accessible (role=dialog, focus trap, Esc)"],"expectedResults":["Delete with confirmation accessible","WCAG 2.1.1, 3.3.4 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_014","title":"Profile page text contrast meets 4.5:1","wcagCriterion":"1.4.3","priority":"High","steps":["Inspect text contrast","Verify ≥4.5:1"],"expectedResults":["Contrast ≥4.5:1","WCAG 1.4.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_015","title":"Focus indicators visible","wcagCriterion":"2.4.7","priority":"High","steps":["Tab through elements","Verify focus outlines visible"],"expectedResults":["Focus indicators visible","WCAG 2.4.7 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_016","title":"Profile page usable at 200% zoom","wcagCriterion":"1.4.4","priority":"High","steps":["Set zoom to 200%","Verify content visible"],"expectedResults":["Usable at 200%","WCAG 1.4.4 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_017","title":"Profile page responsive on mobile","wcagCriterion":"1.4.10","priority":"High","steps":["Set viewport to 375x667","Verify tabs and content visible"],"expectedResults":["Responsive on mobile","WCAG 1.4.10 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_018","title":"No keyboard traps on profile page","wcagCriterion":"2.1.2","priority":"Critical","steps":["Tab through all elements","Verify no traps"],"expectedResults":["No keyboard traps","WCAG 2.1.2 compliant"],"testResult":"NOT RUN"}]}
