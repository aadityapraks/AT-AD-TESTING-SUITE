      "steps": [
        "Navigate to home page",
        "Press Tab repeatedly to reach Catalog link",
        "Verify Catalog link receives focus",
        "Verify focus indicator is visible"
      ],
      "expectedResults": [
        "Catalog link reachable via Tab key",
        "Focus indicator visible with ≥3:1 contrast",
        "WCAG 2.1.1, 2.4.7 compliant"
      ],
      "testResult": "NOT RUN"
    },
