{
  "jiraStory": "SCRUM-73",
  "title": "SCRUM-73: PwD - Navigate to Catalog Tab from Home Page - Accessibility Test Plan",
  "overview": "Accessibility test plan for PwD Navigate to Catalog Tab feature covering WCAG 2.1 AA compliance: ARIA labels on Catalog link, keyboard focusability, focus management after navigation, screen reader compatibility, color contrast, responsive layout.",
  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "Catalog link has descriptive ARIA label",
      "wcagCriterion": "4.1.2 Name, Role, Value",
      "priority": "Critical",
      "relatedJiraIssue": "SCRUM-73",
      "steps": [
        "Navigate to home page",
        "Inspect Catalog link in navigation",
        "Verify aria-label or accessible name is present",
        "Verify accessible name is descriptive (e.g. 'Open assistive device catalog')"
      ],
      "expectedResults": [
        "Catalog link has accessible name 'Open assistive device catalog'",
        "Screen reader announces the descriptive label",
        "WCAG 4.1.2 compliant"
      ],
      "testResult": "NOT RUN"
    },
    {
