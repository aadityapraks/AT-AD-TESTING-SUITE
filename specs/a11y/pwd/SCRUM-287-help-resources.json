{"jiraStory":"SCRUM-287","title":"SCRUM-287: PwD - Help & Resources - Accessibility Test Plan","overview":"Accessibility test plan for Help & Resources: nav link accessible, h1 title with subtitle, search bar with ARIA label, tabs (Help Topics/FAQ/Contact Us) with role=tab/tablist/tabpanel and aria-selected, FAQ accordion with aria-expanded keyboard operable, Contact Us tel:/mailto: links, Back to Help Center CTA, helpful prompt Yes/No keyboard accessible, contrast ≥4.5:1, 200% zoom, mobile responsive, no keyboard traps.","testCases":[{"id":"TC_A11Y_001","title":"Help & Resources nav link keyboard accessible","wcagCriterion":"2.1.1","priority":"Critical","steps":["Tab to Help & Resources nav link","Verify focusable","Press Enter to navigate"],"expectedResults":["Nav link keyboard accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_002","title":"Help page has h1 title","wcagCriterion":"1.3.1","priority":"High","steps":["Navigate to Help page","Verify h1 heading present","Verify subtitle visible"],"expectedResults":["h1 title present","WCAG 1.3.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_003","title":"Search bar has ARIA label","wcagCriterion":"4.1.2, 3.3.2","priority":"Critical","steps":["Locate search input","Verify accessible name","Verify keyboard focusable"],"expectedResults":["Search bar labeled","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_004","title":"Tabs use role=tab/tablist/tabpanel","wcagCriterion":"4.1.2","priority":"Critical","steps":["Inspect tab elements","Verify role=tab on each tab","Verify role=tablist on container","Verify role=tabpanel on panels"],"expectedResults":["ARIA tab roles present","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_005","title":"Active tab has aria-selected=true","wcagCriterion":"4.1.2","priority":"Critical","steps":["Click a tab","Verify aria-selected=true on active","Verify aria-selected=false on others"],"expectedResults":["Active tab indicated","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_006","title":"Tabs keyboard navigable with arrow keys","wcagCriterion":"2.1.1","priority":"Critical","steps":["Focus first tab","Press ArrowRight","Verify focus moves to next tab"],"expectedResults":["Arrow keys navigate tabs","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_007","title":"FAQ accordion items have aria-expanded","wcagCriterion":"4.1.2","priority":"High","steps":["Click FAQ tab","Inspect accordion items","Verify aria-expanded attribute","Click to expand and verify state toggles"],"expectedResults":["Accordion has aria-expanded","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_008","title":"FAQ accordion keyboard operable","wcagCriterion":"2.1.1","priority":"High","steps":["Tab to FAQ item","Press Enter/Space to expand","Verify content visible"],"expectedResults":["Accordion keyboard operable","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_009","title":"Contact Us email uses mailto: link","wcagCriterion":"1.3.1","priority":"High","steps":["Click Contact Us tab","Verify email is mailto: link","Verify keyboard accessible"],"expectedResults":["Email is mailto: link","WCAG 1.3.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_010","title":"Contact Us phone uses tel: link","wcagCriterion":"1.3.1","priority":"High","steps":["Click Contact Us tab","Verify phone is tel: link","Verify keyboard accessible"],"expectedResults":["Phone is tel: link","WCAG 1.3.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_011","title":"Back to Help Center CTA keyboard accessible","wcagCriterion":"2.1.1","priority":"High","steps":["Navigate to article page","Tab to Back to Help Center link","Verify focusable","Press Enter"],"expectedResults":["Back CTA accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_012","title":"Helpful prompt Yes/No buttons keyboard accessible","wcagCriterion":"2.1.1","priority":"High","steps":["Navigate to article page","Tab to Yes/No buttons","Verify focusable","Press Enter to activate"],"expectedResults":["Prompt buttons accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_013","title":"Help page text contrast meets 4.5:1","wcagCriterion":"1.4.3","priority":"High","steps":["Inspect text contrast","Verify ≥4.5:1"],"expectedResults":["Contrast ≥4.5:1","WCAG 1.4.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_014","title":"Focus indicators visible","wcagCriterion":"2.4.7","priority":"High","steps":["Tab through elements","Verify focus outlines visible"],"expectedResults":["Focus indicators visible","WCAG 2.4.7 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_015","title":"Help page usable at 200% zoom","wcagCriterion":"1.4.4","priority":"High","steps":["Set zoom to 200%","Verify content visible"],"expectedResults":["Usable at 200%","WCAG 1.4.4 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_016","title":"Help page responsive on mobile","wcagCriterion":"1.4.10","priority":"High","steps":["Set viewport to 375x667","Verify content visible"],"expectedResults":["Responsive on mobile","WCAG 1.4.10 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_017","title":"No keyboard traps on Help page","wcagCriterion":"2.1.2","priority":"Critical","steps":["Tab through all elements","Verify no traps"],"expectedResults":["No keyboard traps","WCAG 2.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_018","title":"No-results search message announced","wcagCriterion":"4.1.3","priority":"High","steps":["Search for non-existent term","Verify no-results message visible","Verify announced to screen readers"],"expectedResults":["No-results announced","WCAG 4.1.3 compliant"],"testResult":"NOT RUN"}]}
