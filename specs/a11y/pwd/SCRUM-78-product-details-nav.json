{
  "jiraStory": "SCRUM-78",
  "title": "SCRUM-78: PwD - Navigate from Catalog to Product Details Page - Accessibility Test Plan",
  "overview": "Accessibility test plan for catalog-to-product-details navigation: focus moves to h1 product name after navigation, breadcrumb links keyboard-focusable with aria-labels, page landmarks (header/main/footer), ARIA live region announces page load, back button preserves filters, contrast ≥4.5:1, 200% zoom.",
  "testCases": [
    { "id": "TC_A11Y_001", "title": "Focus moves to h1 product name after navigation", "wcagCriterion": "2.4.3", "priority": "Critical", "steps": ["Click View Details on a product card", "Verify focus moves to h1 heading or main content", "Verify h1 contains product name"], "expectedResults": ["Focus on h1 after navigation", "WCAG 2.4.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_002", "title": "Product details page has h1 heading with product name", "wcagCriterion": "1.3.1", "priority": "Critical", "steps": ["Navigate to product details page", "Verify h1 heading exists", "Verify heading contains product name"], "expectedResults": ["h1 heading present with product name", "WCAG 1.3.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_003", "title": "Breadcrumb links are keyboard-focusable", "wcagCriterion": "2.1.1, 2.4.8", "priority": "High", "steps": ["Navigate to product details page", "Tab to breadcrumb links", "Verify each link focusable", "Verify focus indicators visible"], "expectedResults": ["Breadcrumb links keyboard accessible", "WCAG 2.1.1, 2.4.8 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_004", "title": "Breadcrumb links have descriptive aria-labels", "wcagCriterion": "2.4.4", "priority": "High", "steps": ["Inspect breadcrumb links", "Verify accessible names like 'Go to Catalog' or 'Back to catalog'"], "expectedResults": ["Breadcrumb links have descriptive labels", "WCAG 2.4.4 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_005", "title": "Page has header, main, and footer landmarks", "wcagCriterion": "1.3.1", "priority": "High", "steps": ["Navigate to product details page", "Verify banner/header landmark exists", "Verify main landmark exists", "Verify contentinfo/footer landmark exists"], "expectedResults": ["All landmarks present", "WCAG 1.3.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_006", "title": "Page title is descriptive", "wcagCriterion": "2.4.2", "priority": "High", "steps": ["Navigate to product details page", "Verify document title contains product name or 'Product'"], "expectedResults": ["Page title descriptive", "WCAG 2.4.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_007", "title": "URL updates to reflect product slug", "wcagCriterion": "2.4.8", "priority": "Medium", "steps": ["Navigate to product details page", "Verify URL contains /product/ and product slug"], "expectedResults": ["URL reflects product", "Bookmarkable"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_008", "title": "Page loads within 3 seconds", "wcagCriterion": "2.2.1", "priority": "Medium", "steps": ["Click View Details", "Measure load time", "Verify ≤3 seconds"], "expectedResults": ["Page loads within 3s", "No timeout barriers"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_009", "title": "Back button returns to catalog with filters intact", "wcagCriterion": "3.2.3", "priority": "High", "steps": ["Apply filter on catalog", "Navigate to product details", "Press browser Back", "Verify catalog loads with filters intact"], "expectedResults": ["Filters preserved on back navigation", "WCAG 3.2.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_010", "title": "Skip to content link available on product page", "wcagCriterion": "2.4.1", "priority": "High", "steps": ["Navigate to product details page", "Press Tab", "Verify skip link appears", "Activate skip link"], "expectedResults": ["Skip link functional", "WCAG 2.4.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_011", "title": "Product page text contrast meets 4.5:1", "wcagCriterion": "1.4.3", "priority": "High", "steps": ["Inspect product name, price, description text", "Verify contrast ≥4.5:1"], "expectedResults": ["Text contrast ≥4.5:1", "WCAG 1.4.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_012", "title": "Product page usable at 200% zoom", "wcagCriterion": "1.4.4, 1.4.10", "priority": "High", "steps": ["Set zoom to 200%", "Verify all content visible", "Verify no horizontal scrolling", "Verify no overlap"], "expectedResults": ["Page usable at 200%", "WCAG 1.4.4, 1.4.10 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_013", "title": "Product page accessible on mobile viewport", "wcagCriterion": "1.4.10", "priority": "High", "steps": ["Set viewport to 375x667", "Verify content visible", "Verify no horizontal scrolling"], "expectedResults": ["Page accessible on mobile", "WCAG 1.4.10 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_014", "title": "No keyboard traps on product details page", "wcagCriterion": "2.1.2", "priority": "Critical", "steps": ["Tab through all elements on product page", "Verify focus moves freely", "Verify no element traps focus"], "expectedResults": ["No keyboard traps", "WCAG 2.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_015", "title": "Product details persist after page refresh", "wcagCriterion": "3.2.3", "priority": "Medium", "steps": ["Navigate to product details", "Refresh page", "Verify product details still displayed"], "expectedResults": ["Content persists after refresh"], "testResult": "NOT RUN" }
  ]
