{
  "jiraStory": "SCRUM-76",
  "title": "SCRUM-76: PwD - Sort and View Product Listings - Accessibility Test Plan",
  "overview": "Accessibility test plan for sort dropdown and view toggle: Sort By dropdown keyboard accessible with aria-expanded, sorting triggers ARIA live region update, view toggle buttons with aria-pressed, grid/list heading structure (h3 for product names), focus/hover contrast ≥3:1, Tab/arrow key navigation through cards without traps.",
  "testCases": [
    { "id": "TC_A11Y_001", "title": "Sort By dropdown has accessible label", "wcagCriterion": "4.1.2", "priority": "Critical", "steps": ["Navigate to catalog", "Inspect Sort By dropdown", "Verify accessible name 'Sort by'"], "expectedResults": ["Dropdown has accessible name", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_002", "title": "Sort By dropdown keyboard operable", "wcagCriterion": "2.1.1", "priority": "Critical", "steps": ["Tab to Sort By dropdown", "Verify focus indicator", "Use Arrow keys to navigate options", "Verify selection changes"], "expectedResults": ["Dropdown reachable via Tab", "Arrow keys navigate options", "WCAG 2.1.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_003", "title": "Sort By dropdown supports aria-expanded", "wcagCriterion": "4.1.2", "priority": "High", "steps": ["Inspect Sort By dropdown", "Verify aria-expanded or native select behavior", "Open dropdown and verify state"], "expectedResults": ["Dropdown state communicated", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_004", "title": "Sorting triggers live region announcement", "wcagCriterion": "4.1.3", "priority": "High", "steps": ["Change sort option", "Verify results update", "Check for aria-live or role=status on device count"], "expectedResults": ["Sort change announced via live region", "WCAG 4.1.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_005", "title": "Sort options include all required values", "wcagCriterion": "4.1.2", "priority": "High", "steps": ["Open Sort By dropdown", "Verify options: Most Popular, Highest Rated, Price Low to High, Price High to Low, Name A-Z"], "expectedResults": ["All sort options present", "Each option has descriptive text"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_006", "title": "View toggle buttons have accessible names and aria-pressed", "wcagCriterion": "4.1.2", "priority": "High", "steps": ["Locate grid/list view toggle buttons", "Verify each has accessible name", "Verify aria-pressed reflects current state"], "expectedResults": ["Toggle buttons labeled", "aria-pressed indicates active view", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_007", "title": "View toggle keyboard operable", "wcagCriterion": "2.1.1", "priority": "High", "steps": ["Tab to view toggle buttons", "Press Enter/Space to switch view", "Verify view changes"], "expectedResults": ["Toggle buttons keyboard accessible", "WCAG 2.1.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_008", "title": "Product names use h3 heading structure", "wcagCriterion": "1.3.1", "priority": "High", "steps": ["Navigate to catalog", "Inspect product card headings", "Verify product names are h3 elements"], "expectedResults": ["Product names in h3 headings", "WCAG 1.3.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_009", "title": "Product cards navigable via Tab without traps", "wcagCriterion": "2.1.1, 2.1.2", "priority": "Critical", "steps": ["Tab through product cards", "Verify each card's View Details link focusable", "Verify no keyboard traps", "Tab past all cards to pagination"], "expectedResults": ["Cards navigable via Tab", "No keyboard traps", "WCAG 2.1.1, 2.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_010", "title": "Focus indicators on cards meet 3:1 contrast", "wcagCriterion": "2.4.7", "priority": "High", "steps": ["Tab to product card/link", "Verify focus outline visible", "Verify contrast ≥3:1"], "expectedResults": ["Focus indicators visible", "Contrast ≥3:1", "WCAG 2.4.7 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_011", "title": "Hover does not trigger unexpected context change", "wcagCriterion": "3.2.1", "priority": "High", "steps": ["Hover over product card", "Verify no automatic navigation occurs", "Verify only visual highlight changes"], "expectedResults": ["No unexpected navigation on hover", "WCAG 3.2.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_012", "title": "Grid view logical reading order for screen readers", "wcagCriterion": "1.3.2", "priority": "High", "steps": ["Enable screen reader", "Navigate through product grid", "Verify reading order matches visual layout (left-to-right, top-to-bottom)"], "expectedResults": ["Reading order logical", "WCAG 1.3.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_013", "title": "Product card text contrast meets 4.5:1", "wcagCriterion": "1.4.3", "priority": "High", "steps": ["Inspect product name, price, description text contrast", "Verify ≥4.5:1 for normal text"], "expectedResults": ["Text contrast ≥4.5:1", "WCAG 1.4.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_014", "title": "Cards usable at 200% zoom", "wcagCriterion": "1.4.4", "priority": "High", "steps": ["Set zoom to 200%", "Verify cards visible and readable", "Verify no horizontal scrolling", "Verify no content overlap"], "expectedResults": ["Cards usable at 200%", "WCAG 1.4.4, 1.4.10 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_015", "title": "Mobile viewport renders cards accessibly", "wcagCriterion": "1.4.10", "priority": "High", "steps": ["Set viewport to 375x667", "Verify cards visible", "Verify sort dropdown accessible", "Verify no horizontal scrolling"], "expectedResults": ["Cards accessible on mobile", "WCAG 1.4.10 compliant"], "testResult": "NOT RUN" }
  ]
}
