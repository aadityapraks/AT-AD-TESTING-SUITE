{
  "jiraStory": "SCRUM-74",
  "title": "SCRUM-74: PwD - View Catalog Landing Page with Filters - Accessibility Test Plan",
  "overview": "Accessibility test plan for PwD Catalog Filters feature covering WCAG 2.1 AA compliance: filter panel labels, keyboard-operable dropdowns/checkboxes, aria-checked/aria-label, collapsible filter section, Reset All keyboard reachable, live-region announcements, pagination landmark with aria-label, aria-current=page, keyboard navigation, focus indicators, 44x44px touch targets, ellipsis aria-hidden.",
  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "Filter dropdowns have accessible labels",
      "wcagCriterion": "4.1.2 Name, Role, Value",
      "priority": "Critical",
      "relatedJiraIssue": "SCRUM-74",
      "steps": [
        "Navigate to catalog page",
        "Inspect Disability Type dropdown",
        "Verify accessible name 'Disability Type'",
        "Inspect Sub Category, Type, Price Range dropdowns",
        "Verify each has descriptive accessible name"
      ],
      "expectedResults": [
        "All filter dropdowns have programmatic labels",
        "Screen reader announces label when focused",
        "WCAG 4.1.2, 3.3.2 compliant"
      ],
      "testResult": "NOT RUN"
    },
    {
      "id": "TC_A11Y_002",
      "title": "Filter dropdowns keyboard operable",
      "wcagCriterion": "2.1.1 Keyboard",
      "priority": "Critical",
      "relatedJiraIssue": "SCRUM-74",
      "steps": [
        "Tab to Disability Type dropdown",
        "Verify focus indicator visible",
        "Use Arrow keys to navigate options",
        "Press Enter/Space to select",
        "Repeat for Sub Category, Type, Price Range"
      ],
      "expectedResults": [
        "All dropdowns reachable via Tab",
        "Arrow keys navigate options",
        "Selection via Enter/Space",
        "WCAG 2.1.1 compliant"
      ],
      "testResult": "NOT RUN"
    },
