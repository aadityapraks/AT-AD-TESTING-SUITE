{"jiraStory":"SCRUM-82","title":"SCRUM-82: PwD - Product Image Gallery Interaction - Accessibility Test Plan","overview":"Accessibility test plan for image gallery: thumbnails as buttons with descriptive ALT, ARIA live region on image change, lightbox with focus trap/Esc/close button, video player with captions and keyboard controls, reduced-motion respect, consistent aspect ratio, 200% zoom.","testCases":[{"id":"TC_A11Y_001","title":"Main product image has descriptive ALT text","wcagCriterion":"1.1.1","priority":"Critical","steps":["Navigate to product page","Inspect main gallery image","Verify alt attribute present and descriptive"],"expectedResults":["Image has descriptive ALT","WCAG 1.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_002","title":"Thumbnails are buttons with descriptive ALT text","wcagCriterion":"1.1.1, 4.1.2","priority":"Critical","steps":["Inspect thumbnail elements","Verify each is a button","Verify img inside has alt text"],"expectedResults":["Thumbnails are buttons with ALT","WCAG 1.1.1, 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_003","title":"Thumbnails keyboard focusable","wcagCriterion":"2.1.1","priority":"Critical","steps":["Tab to thumbnails","Verify each focusable","Verify focus indicator visible","Press Enter to select"],"expectedResults":["Thumbnails keyboard accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_004","title":"Selecting thumbnail updates main image with ARIA live announcement","wcagCriterion":"4.1.3","priority":"High","steps":["Click a thumbnail","Verify main image updates","Check for aria-live region announcing change"],"expectedResults":["Image update announced","WCAG 4.1.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_005","title":"Gallery prev/next buttons keyboard accessible","wcagCriterion":"2.1.1","priority":"High","steps":["Tab to prev/next buttons","Verify focusable","Press Enter to navigate","Verify image changes"],"expectedResults":["Nav buttons keyboard accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_006","title":"Gallery prev/next buttons have accessible names","wcagCriterion":"4.1.2","priority":"High","steps":["Inspect prev/next buttons","Verify accessible name present"],"expectedResults":["Buttons have accessible names","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_007","title":"Lightbox traps keyboard focus","wcagCriterion":"2.1.2","priority":"Critical","steps":["Click main image to open lightbox","Tab through lightbox elements","Verify focus stays inside lightbox"],"expectedResults":["Focus trapped in lightbox","WCAG 2.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_008","title":"Lightbox has clear Close button","wcagCriterion":"4.1.2","priority":"Critical","steps":["Open lightbox","Verify Close button visible","Verify accessible name"],"expectedResults":["Close button present and labeled","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_009","title":"Lightbox closes with Escape key","wcagCriterion":"2.1.1","priority":"Critical","steps":["Open lightbox","Press Escape","Verify lightbox closes","Verify focus returns to trigger"],"expectedResults":["Esc closes lightbox","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_010","title":"Video Play button keyboard accessible","wcagCriterion":"2.1.1","priority":"High","steps":["Locate Play/Preview button","Tab to button","Press Enter to activate","Verify video plays"],"expectedResults":["Play button keyboard accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_011","title":"Video player has keyboard controls","wcagCriterion":"2.1.1","priority":"High","steps":["Play video","Verify play/pause via Space","Verify volume controls accessible"],"expectedResults":["Video controls keyboard accessible","WCAG 2.1.1 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_012","title":"Video has captions or transcript","wcagCriterion":"1.2.2","priority":"High","steps":["Play video","Verify captions available or transcript link present"],"expectedResults":["Captions/transcript available","WCAG 1.2.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_013","title":"Gallery respects reduced-motion settings","wcagCriterion":"2.3.3","priority":"Medium","steps":["Set prefers-reduced-motion: reduce","Navigate gallery","Verify no animations"],"expectedResults":["Reduced motion respected","WCAG 2.3.3 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_014","title":"Gallery images maintain consistent aspect ratio","wcagCriterion":"1.4.10","priority":"Medium","steps":["View multiple gallery images","Verify consistent aspect ratio"],"expectedResults":["Consistent aspect ratio","No layout shift"],"testResult":"NOT RUN"},{"id":"TC_A11Y_015","title":"Gallery usable at 200% zoom","wcagCriterion":"1.4.4","priority":"High","steps":["Set zoom to 200%","Verify gallery visible","Verify thumbnails and nav buttons usable"],"expectedResults":["Gallery usable at 200%","WCAG 1.4.4 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_016","title":"Gallery accessible on mobile viewport","wcagCriterion":"1.4.10","priority":"High","steps":["Set viewport to 375x667","Verify gallery visible","Verify touch targets adequate"],"expectedResults":["Gallery accessible on mobile","WCAG 1.4.10 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_017","title":"No keyboard traps in gallery","wcagCriterion":"2.1.2","priority":"Critical","steps":["Tab through all gallery elements","Verify focus moves past gallery","No traps"],"expectedResults":["No keyboard traps","WCAG 2.1.2 compliant"],"testResult":"NOT RUN"},{"id":"TC_A11Y_018","title":"Gallery counter accessible","wcagCriterion":"4.1.2","priority":"Medium","steps":["Navigate gallery","Verify counter text like '1 / 3'","Verify accessible to screen readers"],"expectedResults":["Counter accessible","WCAG 4.1.2 compliant"],"testResult":"NOT RUN"}]}
