{
  "jiraStory": "SCRUM-79",
  "title": "SCRUM-79: PwD - View Product Overview Section (Header and Gallery) - Accessibility Test Plan",
  "overview": "Accessibility test plan for product overview header and gallery: product tags with semantic badges and aria-label, gallery main image ALT text, thumbnails keyboard-focusable with aria-selected, stock badge contrast ≥4.5:1, CTAs (Contact Vendor/Save/Share) keyboard-operable with aria-pressed, image index announcement, reduced-motion respect, 200% zoom.",
  "testCases": [
    { "id": "TC_A11Y_001", "title": "Product name is h1 heading", "wcagCriterion": "1.3.1", "priority": "Critical", "steps": ["Navigate to product details", "Verify product name is h1", "Verify screen reader announces heading"], "expectedResults": ["h1 heading with product name", "WCAG 1.3.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_002", "title": "Product tags have semantic badges with accessible text", "wcagCriterion": "1.3.1, 4.1.2", "priority": "High", "steps": ["Inspect product tags", "Verify tags have text content", "Verify tags readable by screen readers"], "expectedResults": ["Tags have programmatic text", "WCAG 1.3.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_003", "title": "Star rating has accessible label with value", "wcagCriterion": "1.1.1, 4.1.2", "priority": "Critical", "steps": ["Inspect rating element", "Verify accessible label like 'Rated X out of 5'", "Verify review count accessible"], "expectedResults": ["Rating announced with value", "WCAG 1.1.1, 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_004", "title": "Stock badge meets contrast ≥4.5:1 and is announced", "wcagCriterion": "1.4.3, 1.4.1", "priority": "High", "steps": ["Locate In Stock/Out of Stock badge", "Verify text label present (not color-only)", "Verify contrast ≥4.5:1"], "expectedResults": ["Badge has text, meets contrast", "WCAG 1.4.3, 1.4.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_005", "title": "Price text accessible with currency symbol", "wcagCriterion": "4.1.2", "priority": "High", "steps": ["Locate price text", "Verify ₹ symbol and numeric value present", "Verify screen reader announces price"], "expectedResults": ["Price accessible", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_006", "title": "Gallery main image has descriptive ALT text", "wcagCriterion": "1.1.1", "priority": "Critical", "steps": ["Inspect main gallery image", "Verify alt attribute present and descriptive"], "expectedResults": ["Image has descriptive ALT", "WCAG 1.1.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_007", "title": "Gallery thumbnails keyboard-focusable with focus rings", "wcagCriterion": "2.1.1, 2.4.7", "priority": "Critical", "steps": ["Tab to gallery thumbnails", "Verify each thumbnail focusable", "Verify focus ring visible", "Press Enter to select thumbnail"], "expectedResults": ["Thumbnails keyboard accessible", "Focus rings visible", "WCAG 2.1.1, 2.4.7 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_008", "title": "Selected thumbnail announced with aria-selected", "wcagCriterion": "4.1.2", "priority": "High", "steps": ["Click a thumbnail", "Verify active thumbnail has aria-selected=true or is-active class", "Verify screen reader announces selection"], "expectedResults": ["Selected state communicated", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_009", "title": "Gallery prev/next buttons keyboard accessible", "wcagCriterion": "2.1.1", "priority": "High", "steps": ["Tab to gallery prev/next buttons", "Verify focus indicators", "Press Enter to navigate", "Verify image changes"], "expectedResults": ["Nav buttons keyboard accessible", "WCAG 2.1.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_010", "title": "Gallery counter announces image index", "wcagCriterion": "4.1.2", "priority": "High", "steps": ["Navigate gallery images", "Verify counter text like '1 / 3'", "Verify counter accessible to screen readers"], "expectedResults": ["Image index announced", "WCAG 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_011", "title": "Contact Vendor button keyboard accessible", "wcagCriterion": "2.1.1, 4.1.2", "priority": "Critical", "steps": ["Tab to Contact Vendor button", "Verify focus indicator", "Verify accessible name", "Press Enter to activate"], "expectedResults": ["Button keyboard accessible", "WCAG 2.1.1, 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_012", "title": "Save button keyboard accessible with toggle state", "wcagCriterion": "2.1.1, 4.1.2", "priority": "High", "steps": ["Tab to Save button", "Verify accessible name", "Press Enter to toggle", "Verify aria-pressed or state change"], "expectedResults": ["Save button toggleable via keyboard", "WCAG 2.1.1, 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_013", "title": "Share button keyboard accessible", "wcagCriterion": "2.1.1, 4.1.2", "priority": "High", "steps": ["Tab to Share button", "Verify accessible name", "Press Enter to activate", "Verify share panel opens"], "expectedResults": ["Share button keyboard accessible", "WCAG 2.1.1, 4.1.2 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_014", "title": "Gallery respects reduced-motion preference", "wcagCriterion": "2.3.3", "priority": "Medium", "steps": ["Set prefers-reduced-motion: reduce", "Navigate gallery", "Verify no animations or transitions"], "expectedResults": ["Reduced motion respected", "WCAG 2.3.3 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_015", "title": "Product overview usable at 200% zoom", "wcagCriterion": "1.4.4, 1.4.10", "priority": "High", "steps": ["Set zoom to 200%", "Verify all overview content visible", "Verify no overlap or horizontal scrolling"], "expectedResults": ["Overview usable at 200%", "WCAG 1.4.4, 1.4.10 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_016", "title": "Product overview accessible on mobile viewport", "wcagCriterion": "1.4.10", "priority": "High", "steps": ["Set viewport to 375x667", "Verify all overview elements visible", "Verify CTAs tappable"], "expectedResults": ["Overview accessible on mobile", "WCAG 1.4.10 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_017", "title": "Geography link keyboard accessible", "wcagCriterion": "2.1.1", "priority": "Medium", "steps": ["Tab to geography link", "Verify focusable", "Press Enter to open off-canvas"], "expectedResults": ["Geography link keyboard accessible", "WCAG 2.1.1 compliant"], "testResult": "NOT RUN" },
    { "id": "TC_A11Y_018", "title": "No keyboard traps in product overview section", "wcagCriterion": "2.1.2", "priority": "Critical", "steps": ["Tab through all overview elements", "Verify focus moves freely past gallery, CTAs, and info"], "expectedResults": ["No keyboard traps", "WCAG 2.1.2 compliant"], "testResult": "NOT RUN" }
  ]
}
