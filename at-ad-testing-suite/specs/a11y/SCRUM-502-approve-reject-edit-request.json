        "5. Verify focus moves to prompt",
        "6. Verify Confirm and Cancel buttons keyboard accessible",
        "7. Verify Escape closes prompt"
      ],
      "expectedResults": [
        "Confirmation prompt appears",
        "Prompt has proper role",
        "Prompt has accessible name",
        "Focus moves to prompt",
