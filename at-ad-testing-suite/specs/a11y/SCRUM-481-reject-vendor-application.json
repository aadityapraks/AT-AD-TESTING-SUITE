      "steps": [
        "1. Locate Reject button",
        "2. Verify button has text label 'Reject' (not just red color/icon)",
        "3. Verify button distinguishable from Approve button without color",
        "4. Test in grayscale mode",
        "5. Verify button text has 4.5:1 contrast"
      ],
      "expectedResults": [
        "Button has text label 'Reject'",
        "Button identifiable without color",
        "Distinguishable from Approve in grayscale",
        "Button text has 4.5:1 contrast",
        "WCAG 1.4.1, 1.4.3 compliant"
      ],
      "postconditions": "Color independence verified",
      "testResult": "PASS"
