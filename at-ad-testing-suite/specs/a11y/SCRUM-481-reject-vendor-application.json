{
  "jiraStory": "SCRUM-481",
  "title": "Admin Reject Vendor Application - Accessibility Test Plan (WCAG 2.1 AA)",
  "overview": "Comprehensive accessibility test plan for Admin Reject Vendor Application feature covering WCAG 2.1 AA compliance for Reject button, rejection reason textarea, confirmation dialog, disabled state when no reason provided, rejection notification, status change, and resubmission flow.",
  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "Reject button keyboard accessible",
      "wcagCriterion": "2.1.1 Keyboard, 4.1.2 Name Role Value",
      "componentElement": "Reject button on Pending vendor",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Admin is viewing a Pending vendor",
      "steps": [
        "1. Tab to Reject button",
        "2. Verify focus indicator visible with 3:1 contrast",
        "3. Verify button has accessible name ('Reject' or 'Reject [Vendor Name]')",
        "4. Verify button has role='button'",
        "5. Press Enter to activate",
        "6. Verify rejection dialog/form opens"
      ],
      "expectedResults": [
        "Reject button reachable via Tab",
        "Focus indicator visible with 3:1 contrast",
        "Button has descriptive accessible name",
        "Button role announced by screen reader",
        "Enter/Space activates button",
        "WCAG 2.1.1, 4.1.2, 2.4.7 compliant"
      ],
      "postconditions": "Rejection dialog/form opened",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_002",
      "title": "Reject button visible only for Pending vendors",
      "wcagCriterion": "4.1.2 Name Role Value",
      "componentElement": "Reject button visibility by status",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Admin is on Vendor Lists page",
      "steps": [
        "1. Navigate to Pending Approval tab — verify Reject button visible",
        "2. Navigate to Active Partners tab — verify Reject button NOT visible",
        "3. Navigate to Rejected tab — verify Reject button NOT visible"
      ],
      "expectedResults": [
        "Reject button visible only on Pending vendors",
        "Button not present on Active/Rejected vendors",
        "No hidden Reject button confusing screen readers",
        "WCAG 4.1.2 compliant"
      ],
      "postconditions": "Button visibility by status verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_003",
      "title": "Rejection reason textarea has proper label",
      "wcagCriterion": "1.3.1 Info and Relationships, 4.1.2 Name Role Value",
      "componentElement": "Rejection reason textarea",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Rejection dialog/form is open",
      "steps": [
        "1. Locate rejection reason textarea",
        "2. Verify visible label present ('Rejection Reason' or similar)",
        "3. Verify label programmatically associated (for/id or aria-labelledby)",
        "4. Verify textarea has aria-required='true' or required attribute",
        "5. Verify placeholder is supplementary, not sole label",
        "6. Use screen reader to verify label announced on focus"
      ],
      "expectedResults": [
        "Textarea has visible label",
        "Label programmatically associated",
        "Required attribute present (aria-required='true' or required)",
        "Placeholder not the only label",
        "Screen reader announces label and required state",
        "WCAG 1.3.1, 4.1.2, 3.3.2 compliant"
      ],
      "postconditions": "Textarea label verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_004",
      "title": "Rejection reason textarea keyboard accessible",
      "wcagCriterion": "2.1.1 Keyboard",
      "componentElement": "Rejection reason textarea",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Rejection dialog/form is open",
      "steps": [
        "1. Tab to rejection reason textarea",
        "2. Verify focus indicator visible",
        "3. Type rejection reason text",
        "4. Verify text appears in textarea",
        "5. Tab to next element (Confirm button)"
      ],
      "expectedResults": [
        "Textarea reachable via Tab",
        "Focus indicator visible",
        "Keyboard input accepted",
        "Tab moves to next element",
        "WCAG 2.1.1, 2.4.7 compliant"
      ],
      "postconditions": "Textarea keyboard accessibility verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_005",
      "title": "Confirm button disabled when no reason provided",
      "wcagCriterion": "4.1.2 Name Role Value",
      "componentElement": "Confirm Rejection button (disabled state)",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Rejection dialog is open with empty reason field",
      "steps": [
        "1. Leave rejection reason empty",
        "2. Verify Confirm button is disabled",
        "3. Verify disabled state has disabled attribute or aria-disabled='true'",
        "4. Verify disabled state announced by screen reader",
        "5. Verify visual indication of disabled state",
        "6. Type reason text — verify button becomes enabled",
        "7. Verify enabled state announced"
      ],
      "expectedResults": [
        "Confirm button disabled when reason empty",
        "Disabled state has disabled or aria-disabled='true'",
        "Screen reader announces 'disabled'",
        "Visual styling shows disabled state",
        "Button enables when reason provided",
        "WCAG 4.1.2 compliant"
      ],
      "postconditions": "Disabled state accessibility verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_006",
      "title": "Rejection confirmation dialog accessible",
      "wcagCriterion": "4.1.2 Name Role Value, 2.1.1 Keyboard",
      "componentElement": "Rejection confirmation dialog",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Admin has entered rejection reason and clicks Confirm",
      "steps": [
        "1. Verify dialog has role='dialog' or role='alertdialog'",
        "2. Verify dialog has accessible name (aria-labelledby or aria-label)",
        "3. Verify focus moves to dialog",
        "4. Verify focus trapped within dialog",
        "5. Verify Escape closes dialog",
        "6. Verify Cancel button returns focus to trigger",
        "7. Verify Confirm button keyboard accessible"
      ],
      "expectedResults": [
        "Dialog has proper role",
        "Dialog has accessible name",
        "Focus moves to dialog on open",
        "Focus trapped within dialog",
        "Escape closes dialog",
        "Focus returns to trigger on close",
        "WCAG 4.1.2, 2.1.1, 2.4.3 compliant"
      ],
      "postconditions": "Confirmation dialog accessibility verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_007",
      "title": "Rejection success notification accessible",
      "wcagCriterion": "4.1.3 Status Messages",
      "componentElement": "Rejection success message",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Admin confirms vendor rejection",
      "steps": [
        "1. Confirm rejection",
        "2. Verify success message appears",
        "3. Verify message has role='status' or aria-live='polite'",
        "4. Verify message announced by screen reader",
        "5. Verify message text clear (e.g., 'Vendor rejected successfully')",
        "6. Verify message has 4.5:1 contrast"
      ],
      "expectedResults": [
        "Success message displayed",
        "Message has role='status' or aria-live='polite'",
        "Screen reader announces message",
        "Message text clear and specific",
        "Message has 4.5:1 contrast",
        "WCAG 4.1.3, 1.4.3 compliant"
      ],
      "postconditions": "Rejection success notification verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_008",
      "title": "Vendor status change to Rejected announced",
      "wcagCriterion": "4.1.3 Status Messages",
      "componentElement": "Vendor status update (Pending → Rejected)",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Admin has rejected a vendor",
      "steps": [
        "1. Reject vendor",
        "2. Verify vendor status changes to 'Rejected'",
        "3. Verify status change announced via aria-live",
        "4. Verify vendor moves to Rejected tab (or removed from Pending)",
        "5. Verify tab counts update and are announced"
      ],
      "expectedResults": [
        "Vendor status changes to Rejected",
        "Status change announced via aria-live",
        "Vendor appears in Rejected tab",
        "Tab counts update",
        "WCAG 4.1.3 compliant"
      ],
      "postconditions": "Status change announcement verified",
      "testResult": "FAIL"
    },
    {
      "id": "TC_A11Y_009",
      "title": "Focus management after rejection",
      "wcagCriterion": "2.4.3 Focus Order",
      "componentElement": "Focus after successful rejection",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-481",
      "preconditions": "Admin has successfully rejected a vendor",
      "steps": [
        "1. Reject vendor successfully",
        "2. Verify vendor card removed from Pending list",
        "3. Verify focus moves to appropriate element (next vendor or list heading)",
        "4. Verify focus not lost on removed element"
      ],
      "expectedResults": [
        "Focus moves to logical next element",
        "Focus not lost on removed element",
        "User can continue keyboard navigation",
        "WCAG 2.4.3 compliant"
      ],
      "postconditions": "Focus management verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_010",
