  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "Queries section keyboard accessible",
      "wcagCriterion": "2.1.1 Keyboard",
      "componentElement": "Queries navigation link",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-201",
      "preconditions": "User logged in as AP user",
      "steps": [
        "1. Login as AP user",
        "2. Tab to Queries in navigation",
        "3. Verify focus indicator visible",
        "4. Press Enter to activate",
        "5. Verify redirects to Queries page"
      ],
      "expectedResults": [
        "Queries link visible in navigation",
        "Link keyboard accessible",
        "Focus indicator meets contrast requirements",
        "WCAG 2.1.1, 2.4.7 compliant"
      ],
      "postconditions": "User navigated to Queries page via keyboard",
      "testResult": "PASS"
    },
