      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-20",
      "preconditions": "Product upload/edit form is loaded, user is logged in as vendor",
      "steps": [
        "1. Navigate to product upload/edit form",
        "2. Tab to Assist with GenAI button next to Short Description",
