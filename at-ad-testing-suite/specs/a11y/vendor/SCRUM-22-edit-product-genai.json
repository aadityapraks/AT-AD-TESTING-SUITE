{"jiraStory":"SCRUM-22","title":"Edit Product with GenAI - Accessibility Test Plan (WCAG 2.1 AA)","overview":"Comprehensive accessibility test plan for Edit Product with GenAI feature covering WCAG 2.1 AA compliance for Edit Product button, product edit form, Enhance with GenAI buttons, ALT text generation, side-by-side comparison, Accept/Edit/Reject actions, version control, confirmation messages, audit logging, and help icons.","testCases":[{"id":"TC_A11Y_001","title":"Verify Edit Product button accessibility","wcagCriterion":"2.1.1 Keyboard","componentElement":"Edit Product Button","priority":"Highest","relatedJiraIssue":"SCRUM-22","preconditions":"User is logged in and on Product Management page","steps":["1. Navigate to Product Management","2. Tab to Edit Product button in actions column","3. Verify focus indicator visible","4. Press Enter/Space to activate","5. Verify edit form opens"],"expectedResults":["Edit button keyboard accessible","Button has accessible name: 'Edit Product'","Focus indicator visible with 3:1 contrast","Button activates with Enter/Space","Edit form opens"],"postconditions":"Edit form is displayed","testResult":"PASS"},{"id":"TC_A11Y_002","title":"Verify Edit button screen reader accessibility","wcagCriterion":"4.1.2 Name Role Value","componentElement":"Edit Product Button","priority":"Highest","relatedJiraIssue":"SCRUM-22","preconditions":"User is logged in and on Product Management page with screen reader enabled","steps":["1. Enable screen reader","2. Navigate to Edit button","3. Verify button name announced","4. Verify button role announced","5. Test button activation"],"expectedResults":["Button role announced","Button name 'Edit Product' announced","Context provided (e.g., 'Edit [Product Name]')","Button state announced","No empty or generic labels"],"postconditions":"Screen reader correctly announces button information","testResult":"PASS"},{"id":"TC_A11Y_003","title":"Verify edit form structure","wcagCriterion":"4.1.2 Name Role Value","componentElement":"Edit Product Form","priority":"Highest","relatedJiraIssue":"SCRUM-22","preconditions":"Edit form is open","steps":["1. Open edit form","2. Use screen reader heading navigation","3. Verify form title heading","4. Check section headings","5. Verify heading hierarchy"],"expectedResults":["Form has proper heading structure","Form title is h1 or h2","Section headings are h2 or h3","Heading hierarchy logical","All headings announced"],"postconditions":"Form structure is semantically correct","testResult":"FAIL"},{"id":"TC_A11Y_004","title":"Verify Enhance with GenAI button accessibility","wcagCriterion":"2.1.1 Keyboard","componentElement":"Enhance with GenAI Buttons","priority":"Highest","relatedJiraIssue":"SCRUM-22","preconditions":"Edit form is open with existing content","steps":["1. Open edit form with existing content","2. Tab to Enhance with GenAI buttons","3. Verify focus indicators","4. Test button activation","5. Verify button states"],"expectedResults":["Enhance buttons keyboard accessible","Buttons present for: Short Description, Detailed Description, Specifications, ALT Text","Focus indicators visible","Buttons activate with Enter/Space","Buttons enabled only when text present"],"postconditions":"GenAI enhancement triggered successfully","testResult":"FAIL"},{"id":"TC_A11Y_005","title":"Verify Enhance button screen reader accessibility","wcagCriterion":"4.1.2 Name Role Value","componentElement":"Enhance with GenAI Buttons","priority":"Highest","relatedJiraIssue":"SCRUM-22","preconditions":"Edit form is open with screen reader enabled","steps":["1. Enable screen reader","2. Navigate to Enhance buttons","3. Tab through each button","4. Verify button names announced","5. Verify tooltip announced"],"expectedResults":["Button role announced","Button name announced with field context","Tooltip text announced on focus","Tooltip: 'Use GenAI to improve clarity, tone, or accessibility'","Button state announced"],"postconditions":"Screen reader correctly announces all button information","testResult":"FAIL"},{"id":"TC_A11Y_006","title":"Verify button tooltip accessibility","wcagCriterion":"4.1.2 Name Role Value","componentElement":"Enhance Button Tooltip","priority":"Highest","relatedJiraIssue":"SCRUM-22","preconditions":"Edit form is open with Enhance buttons visible","steps":["1. Navigate to Enhance button","2. Trigger tooltip with focus","3. Trigger tooltip with hover","4. Verify tooltip announced","5. Test tooltip dismissal"],"expectedResults":["Tooltip triggered by focus and hover","Tooltip has role='tooltip'","Tooltip content announced","Escape dismisses tooltip","Tooltip has 4.5:1 contrast"],"postconditions":"Tooltip is accessible via keyboard and screen reader","testResult":"FAIL"},{"id":"TC_A11Y_007","title":"Verify button disabled state","wcagCriterion":"4.1.2 Name Role Value","componentElement":"Enhance with GenAI Buttons","priority":"Highest","relatedJiraIssue":"SCRUM-22","preconditions":"Edit form is open with empty field","steps":["1. Open edit form with empty field","2. Navigate to Enhance button","3. Verify button disabled","4. Check disabled state announced","5. Test tooltip"],"expectedResults":["Button disabled if field empty","Disabled state has aria-disabled='true'","Disabled state announced","Visual indicator shows disabled","Tooltip explains requirement"],"postconditions":"Disabled state is properly communicated","testResult":"PASS"},{"id":"TC_A11Y_008","title":"Verify ALT text generation button accessibility","wcagCriterion":"2.1.1 Keyboard","componentElement":"ALT Text GenAI Button","priority":"Highest","relatedJiraIssue":"SCRUM-22","preconditions":"Edit form is open with image section visible","steps":["1. Navigate to image section","2. Tab to ALT text GenAI button","3. Verify focus indicator","4. Press Enter/Space","5. Verify ALT text generated"],"expectedResults":["ALT text button keyboard accessible","Button has accessible name: 'Add/Improve ALT Text with GenAI'","Focus indicator