      "wcagCriterion": "4.1.2 Name Role Value",
      "componentElement": "Confirm Rejection button (disabled state)",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-496",
      "preconditions": "Rejection modal is open with empty reason",
      "steps": [
        "1. Leave reason field empty",
        "2. Verify Confirm/Reject button disabled",
        "3. Verify disabled attribute or aria-disabled='true'",
        "4. Verify screen reader announces disabled",
        "5. Type reason — verify button enables",
        "6. Clear reason — verify button disables again"
      ],
      "expectedResults": [
        "Button disabled when reason empty",
        "Disabled state properly attributed",
        "Screen reader announces disabled",
        "Button enables when reason provided",
        "WCAG 4.1.2 compliant"
