{
  "jiraStory": "SCRUM-496",
  "title": "Admin Reject New Product Submission - Accessibility Test Plan (WCAG 2.1 AA)",
  "overview": "Comprehensive accessibility test plan for Admin Reject New Product Submission covering WCAG 2.1 AA compliance for Reject button, rejection modal with mandatory reason field, disabled confirm state, informational text about vendor notification and resubmission, status change announcements, and error handling.",
  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "Reject button keyboard accessible",
      "wcagCriterion": "2.1.1 Keyboard, 4.1.2 Name Role Value",
      "componentElement": "Reject button on product card",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-496",
      "preconditions": "Admin is on New Submissions tab viewing a product",
      "steps": [
        "1. Tab to Reject button",
        "2. Verify focus indicator visible",
        "3. Verify button has accessible name ('Reject' or 'Reject [Product]')",
        "4. Press Enter to activate",
        "5. Verify rejection modal opens"
      ],
      "expectedResults": [
        "Button reachable via Tab",
        "Focus indicator visible",
        "Button has descriptive name",
        "Enter/Space activates",
        "Modal opens",
        "WCAG 2.1.1, 4.1.2 compliant"
      ],
      "postconditions": "Rejection modal open",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_002",
      "title": "Rejection modal has role='dialog' and aria-modal",
      "wcagCriterion": "4.1.2 Name Role Value",
      "componentElement": "Rejection modal dialog",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-496",
      "preconditions": "Rejection modal is open",
      "steps": [
        "1. Verify modal has role='dialog' or role='alertdialog'",
        "2. Verify aria-modal='true'",
        "3. Verify modal has accessible name",
        "4. Verify focus moves to modal",
        "5. Use screen reader to verify dialog announced"
      ],
      "expectedResults": [
        "Modal has proper role",
        "aria-modal='true' present",
        "Modal has accessible name",
        "Focus moves to modal",
        "Dialog announced by screen reader",
        "WCAG 4.1.2 compliant"
      ],
      "postconditions": "Modal ARIA verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_003",
      "title": "Modal focus trap works correctly",
      "wcagCriterion": "2.1.2 No Keyboard Trap",
      "componentElement": "Rejection modal focus management",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-496",
      "preconditions": "Rejection modal is open",
      "steps": [
        "1. Tab through all elements in modal",
        "2. Verify focus cycles within modal",
        "3. Verify background not reachable",
        "4. Verify Escape closes modal",
        "5. Verify focus returns to Reject button"
      ],
      "expectedResults": [
        "Focus trapped within modal",
        "Background not reachable",
        "Escape closes modal",
        "Focus returns to trigger",
        "WCAG 2.1.2 compliant"
      ],
      "postconditions": "Focus trap verified",
      "testResult": "PASS"
