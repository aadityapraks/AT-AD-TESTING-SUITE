      "componentElement": "Rejection reason textarea (mandatory)",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-496",
      "preconditions": "Rejection modal is open",
      "steps": [
        "1. Locate rejection reason textarea",
        "2. Verify visible label present",
        "3. Verify label programmatically associated",
        "4. Verify aria-required='true' or required attribute",
        "5. Verify screen reader announces label and required state",
        "6. Tab to textarea — verify keyboard accessible"
      ],
      "expectedResults": [
        "Textarea has visible label",
        "Label programmatically associated",
        "Required attribute present",
        "Screen reader announces required",
        "Textarea keyboard accessible",
        "WCAG 1.3.1, 4.1.2, 3.3.2 compliant"
      ],
      "postconditions": "Textarea label verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_005",
