{
  "jiraStory": "SCRUM-511",
  "title": "Admin Search Products - Accessibility Test Plan (WCAG 2.1 AA)",
  "overview": "Comprehensive accessibility test plan for Admin Search Products feature covering WCAG 2.1 AA compliance for search input (by name, vendor, category, SKU), cross-tab search, partial keyword support (min 3 chars), no-result state, special characters handling, and loading state during search.",
  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "Search input has proper label",
      "wcagCriterion": "4.1.2 Name Role Value, 1.3.1 Info and Relationships",
      "componentElement": "Product search input field",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-511",
      "preconditions": "Admin is on Product Management Dashboard",
      "steps": [
        "1. Locate search input",
        "2. Verify visible label or aria-label present",
        "3. Verify label programmatically associated",
        "4. Verify role='searchbox' or type='search'",
        "5. Verify placeholder supplementary (not sole label)",
        "6. Use screen reader to verify announced on focus"
      ],
      "expectedResults": [
        "Search has accessible label",
        "Label associated",
        "Input has search role/type",
        "Placeholder supplementary",
        "Screen reader announces purpose",
        "WCAG 4.1.2, 1.3.1, 3.3.2 compliant"
      ],
      "postconditions": "Search label verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_002",
      "title": "Search input keyboard accessible",
      "wcagCriterion": "2.1.1 Keyboard, 2.4.7 Focus Visible",
      "componentElement": "Product search input",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-511",
      "preconditions": "Admin is on Product Management Dashboard",
      "steps": [
        "1. Tab to search input",
        "2. Verify focus indicator visible with 3:1 contrast",
        "3. Type search query",
        "4. Verify text appears",
        "5. Press Enter to submit (if applicable)",
        "6. Tab away — verify no trap"
      ],
      "expectedResults": [
        "Input reachable via Tab",
        "Focus indicator visible",
        "Keyboard input accepted",
        "Enter submits if applicable",
        "No keyboard trap",
        "WCAG 2.1.1, 2.4.7 compliant"
      ],
      "postconditions": "Keyboard accessibility verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_003",
      "title": "Search results announced dynamically",
      "wcagCriterion": "4.1.3 Status Messages",
      "componentElement": "Search results live region",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-511",
      "preconditions": "Admin types search query (3+ chars)",
      "steps": [
        "1. Type product name (3+ characters)",
        "2. Wait for results to update",
        "3. Verify aria-live region announces result count",
        "4. Verify format: 'X products found'",
        "5. Verify focus remains in search input"
      ],
      "expectedResults": [
        "Results update dynamically",
        "aria-live announces count",
        "Format clear",
        "Focus stays in input",
        "WCAG 4.1.3 compliant"
      ],
      "postconditions": "Dynamic announcement verified",
      "testResult": "FAIL"
    },
