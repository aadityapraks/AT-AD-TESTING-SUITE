    {
      "id": "TC_A11Y_003",
      "title": "Product state tabs have proper ARIA tablist pattern",
      "wcagCriterion": "4.1.2 Name Role Value",
      "componentElement": "Product state tabs (New Submissions, Pending Edits, Official AT, Approved, All Products)",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-490",
      "preconditions": "Admin is on Product Management Dashboard",
      "steps": [
        "1. Verify tab container has role='tablist'",
        "2. Verify each tab has role='tab'",
        "3. Verify active tab has aria-selected='true'",
        "4. Verify inactive tabs have aria-selected='false'",
        "5. Verify tab panel has role='tabpanel'",
        "6. Verify aria-controls links tab to panel"
      ],
      "expectedResults": [
        "Container has role='tablist'",
        "Each tab has role='tab'",
        "Active tab has aria-selected='true'",
        "Tab panel has role='tabpanel'",
        "aria-controls links tab to panel",
        "WCAG 4.1.2, 1.3.1 compliant"
      ],
      "postconditions": "Tab ARIA pattern verified",
      "testResult": "FAIL"
    },
