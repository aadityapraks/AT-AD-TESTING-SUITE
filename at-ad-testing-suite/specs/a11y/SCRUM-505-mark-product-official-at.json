{
  "jiraStory": "SCRUM-505",
  "title": "Admin Mark Product as Official AT - Accessibility Test Plan (WCAG 2.1 AA)",
  "overview": "Comprehensive accessibility test plan for Admin Mark Product as Official AT feature covering WCAG 2.1 AA compliance for Official AT designation action, badge display, tab movement, revocation flow, blocked state for unapproved products, and screen reader announcements.",
  "testCases": [
    {
      "id": "TC_A11Y_001",
      "title": "Mark as Official AT button keyboard accessible",
      "wcagCriterion": "2.1.1 Keyboard, 4.1.2 Name Role Value",
      "componentElement": "Mark as Official AT button/action",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-505",
      "preconditions": "Admin is viewing an Approved product",
      "steps": [
        "1. Tab to Mark as Official AT button/action",
        "2. Verify focus indicator visible",
        "3. Verify button has accessible name ('Mark as Official AT' or similar)",
        "4. Press Enter to activate",
        "5. Verify action proceeds (confirmation or immediate)"
      ],
      "expectedResults": [
        "Button keyboard accessible",
        "Focus indicator visible",
        "Button has descriptive name",
        "Enter/Space activates",
        "WCAG 2.1.1, 4.1.2 compliant"
      ],
      "postconditions": "Official AT action triggered",
      "testResult": "FAIL"
    },
    {
      "id": "TC_A11Y_002",
      "title": "Action blocked for unapproved products",
      "wcagCriterion": "4.1.2 Name Role Value",
      "componentElement": "Mark as Official AT button disabled state",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-505",
      "preconditions": "Admin is viewing a non-Approved product (Under Review, Rejected, etc.)",
      "steps": [
        "1. View product that is not Approved",
        "2. Verify Mark as Official AT action not available or disabled",
        "3. If disabled, verify disabled attribute present",
        "4. Verify screen reader announces disabled or action not present",
        "5. Verify reason communicated if disabled"
      ],
      "expectedResults": [
        "Action blocked for non-Approved products",
        "Disabled state properly attributed if button present",
        "Screen reader announces unavailability",
        "WCAG 4.1.2 compliant"
      ],
      "postconditions": "Blocked state verified",
      "testResult": "PASS"
    },
    {
      "id": "TC_A11Y_003",
      "title": "Official AT badge accessible on product card",
      "wcagCriterion": "4.1.2 Name Role Value, 1.4.1 Use of Color",
      "componentElement": "Official AT badge on product card",
      "priority": "Highest",
      "relatedJiraIssue": "SCRUM-505",
      "preconditions": "Product has been marked as Official AT",
      "steps": [
        "1. Locate product card with Official AT badge",
        "2. Verify badge has text label ('Official AT')",
        "3. Verify badge announced by screen reader",
        "4. Verify badge not conveyed by color alone",
        "5. Verify badge text has 4.5:1 contrast",
        "6. Test in grayscale — verify badge identifiable"
      ],
      "expectedResults": [
        "Badge has text label 'Official AT'",
        "Badge announced by screen reader",
        "Not relying on color alone",
        "Badge text has 4.5:1 contrast",
        "Identifiable in grayscale",
        "WCAG 4.1.2, 1.4.1, 1.4.3 compliant"
      ],
      "postconditions": "Badge accessibility verified",
      "testResult": "FAIL"
    },
    {
      "id": "TC_A11Y_004",
      "title": "Official AT designation success announced",
