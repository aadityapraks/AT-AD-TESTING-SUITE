      "relatedJiraIssue": "SCRUM-505",
      "preconditions": "Admin marks product as Official AT",
      "steps": [
        "1. Mark product as Official AT",
        "2. Verify success message appears",
        "3. Verify message has role='status' or aria-live",
        "4. Verify message announced by screen reader",
        "5. Verify message has 4.5:1 contrast"
      ],
      "expectedResults": [
        "Success message displayed",
        "Message has aria-live",
        "Screen reader announces",
        "Message has contrast",
        "WCAG 4.1.3, 1.4.3 compliant"
      ],
      "postconditions": "Success notification verified",
      "testResult": "FAIL"
