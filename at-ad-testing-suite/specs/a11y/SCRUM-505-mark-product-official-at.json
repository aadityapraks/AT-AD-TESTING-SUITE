      "steps": [
        "1. Mark product as Official AT",
        "2. Verify product appears in Official AT tab",
        "3. Verify product still in Approved and All Products tabs",
        "4. Verify tab counts update",
        "5. Verify count updates announced via aria-live"
      ],
      "expectedResults": [
        "Product in Official AT tab",
        "Product still in Approved/All tabs",
        "Tab counts update",
        "Updates announced",
